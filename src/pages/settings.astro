---
import BaseLayout from "../layouts/BaseLayout.astro";
import SettingsForm, {
  type SettingsValues,
} from "../components/settings/SettingsForm";
import { getDb } from "../server/db/client";
import { getSettingsByUserId } from "../server/db/repo";

const session = Astro.locals.session;
if (!session) return Astro.redirect("/login");

const row = await getSettingsByUserId(getDb(), session.user.id);
const initial: SettingsValues | null = row
  ? {
      email: row.email,
      timezone: row.timezone,
      weeklyDigestEnabled: row.weeklyDigestEnabled,
      weeklyDigestHour: row.weeklyDigestHour,
    }
  : null;
---

<BaseLayout title="Settings">
  <SettingsForm client:load initial={initial} />
</BaseLayout>
