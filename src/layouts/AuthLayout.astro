---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "rememberme", description = "A private journal. Yours alone." } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-dvh items-center justify-center bg-background px-4 py-10">
    <main class="w-full max-w-sm">
      <slot />
    </main>
  </body>
</html>
