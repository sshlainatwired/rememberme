# ---------------------------------------------------------------------------
# RememberMe environment configuration
# Copy to .env and fill in. Every variable is validated with Zod at startup.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Database — local SQLite/libSQL file, or a Turso URL like
#   libsql://my-db.turso.io
# DATABASE_AUTH_TOKEN is only needed for remote (Turso) databases.
DATABASE_URL=file:./data/rememberme.db
DATABASE_AUTH_TOKEN=

# Authentication
# BETTER_AUTH_SECRET: generate with `openssl rand -base64 32` (min 32 chars)
# BETTER_AUTH_URL: public URL of this installation (used for cookies)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4321

# Journal encryption key — generate with:
#   openssl rand -base64 32
# Losing this key means losing access to encrypted journal content.
JOURNAL_ENCRYPTION_KEY=

# SMTP for the weekly digest. Optional: the app runs without it, but the
# weekly digest cannot be delivered until these are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=digest@example.com

# Session lifetime (days). Users must sign in again after this.
SESSION_EXPIRES_IN_DAYS=7
