{
  "extends": "astro/tsconfigs/strict",
  "include": ["src", "scripts", "tests", "astro.config.mjs", "drizzle.config.ts"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["@types/bun"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "verbatimModuleSyntax": false
  }
}
