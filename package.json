{
  "name": "rememberme",
  "version": "0.1.0",
  "description": "RememberMe — a self-hosted private personal journal",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "bun run ./dist/server/entry.mjs",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "biome check src tests scripts",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run ./scripts/migrate.ts"
  },
  "dependencies": {
    "@astrojs/node": "^9.2.0",
    "@astrojs/react": "^4.3.0",
    "@libsql/client": "^0.15.4",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.4",
    "@tailwindcss/vite": "^4.1.11",
    "astro": "^5.12.0",
    "better-auth": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.7.9",
    "lucide-react": "^0.525.0",
    "luxon": "^3.6.1",
    "nodemailer": "^7.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.11",
    "zod": "^4.0.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@biomejs/biome": "^2.5.7",
    "@eslint/js": "^9.33.0",
    "@types/bun": "^1.2.19",
    "@types/luxon": "^3.6.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "drizzle-kit": "^0.31.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
