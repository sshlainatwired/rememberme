{
  "name": "rememberme",
  "version": "0.1.0",
  "description": "RememberMe — a self-hosted private personal journal",
  "type": "module",
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "bun run ./dist/server/entry.mjs",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "biome check src tests scripts",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run ./scripts/migrate.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.3",
    "@astrojs/react": "^6.0.2",
    "@libsql/client": "^0.17.4",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.4",
    "@tailwindcss/vite": "^4.1.11",
    "astro": "^7.1.6",
    "better-auth": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.9",
    "lucide-react": "^1.28.0",
    "luxon": "^3.6.1",
    "nodemailer": "^9.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.11",
    "zod": "^4.0.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@biomejs/biome": "^2.5.7",
    "typescript": "^6.0.3",
    "@types/bun": "^1.2.19",
    "@types/luxon": "^3.6.0",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "drizzle-kit": "^0.31.2"
  },
  "overrides": {
    "sharp": "^0.35.3"
  }
}
